<Window x:Class="Control.Components.Users.RegisterPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Register" 
        Height="550" 
        Width="600"
        MinHeight="500"
        MinWidth="500"
        Name="RegisterScreen"
        WindowStartupLocation="CenterScreen"
        Background="#F0F8FF">
    <Grid>
        <Border Background="White" 
                BorderBrush="Black" 
                BorderThickness="1" 
                CornerRadius="8"
                Padding="30"
                VerticalAlignment="Center" 
                HorizontalAlignment="Center"
                MaxWidth="450">

            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Direction="270" RenderingBias="Quality" ShadowDepth="2" Opacity="0.15"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="100"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" 
                           Text="Create Account" 
                           FontSize="22" FontWeight="Bold"
                           Margin="0,0,0,25"
                           HorizontalAlignment="Center"/>

                <TextBlock Grid.Row="1" Grid.Column="0" 
                           Text="Full Name*:" 
                           VerticalAlignment="Center"
                           Margin="0,0,10,12"/>
                <TextBox Grid.Row="1" Grid.Column="1" 
                         Margin="0,0,0,12" Padding="3"
                         Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" 
                           Text="Username*:" 
                           VerticalAlignment="Center"
                           Margin="0,0,10,12"/>
                <TextBox Grid.Row="2" Grid.Column="1" 
                         Margin="0,0,0,12" Padding="3"
                         Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" 
                           Text="Password*:" 
                           VerticalAlignment="Center"
                           Margin="0,0,10,12"/>
                <PasswordBox x:Name="PasswordInput" 
                            Grid.Row="3" Grid.Column="1" 
                            Margin="0,0,0,12" Padding="3"
                            PasswordChanged="PasswordBox_PasswordChanged"/>

                <TextBlock Grid.Row="4" Grid.Column="0" 
                           Text="Email:" 
                           VerticalAlignment="Center"
                           Margin="0,0,10,12"/>
                <TextBox Grid.Row="4" Grid.Column="1" 
                         Margin="0,0,0,20" Padding="3"
                         Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <Button Grid.Row="5" Grid.ColumnSpan="2" 
                        Content="Register" 
                        Width="150" 
                        Height="35"
                        Background="#F5F5F5"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Command="{Binding RegisterCommand}"
                        HorizontalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>