<Window x:Class="Control.Components.Common.ReviewScreen"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:app="clr-namespace:Control.Components.JobApplication"
      mc:Ignorable="d" 
      Title="Review Applications"
      Height="600" Width="800"
      Background="#F0F8FF">

    <Grid>
        <Border Background="White" 
                BorderBrush="Black" 
                BorderThickness="1" 
                CornerRadius="8"
                Width="700" 
                Margin="20"
                VerticalAlignment="Stretch" 
                HorizontalAlignment="Center"
                Padding="20">

            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Direction="270" RenderingBias="Quality" ShadowDepth="2" Opacity="0.2"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock 
                    Grid.Row="0"
                    Text="Submitted Applications"
                    FontSize="26"
                    FontWeight="Bold"
                    Margin="0,0,0,20"
                    HorizontalAlignment="Center"/>

                <TextBlock 
                        Grid.Row="1"
                        Text="{Binding Greeting}"
                        FontSize="16"
                        Foreground="#555"
                        Margin="0,0,0,25"
                        HorizontalAlignment="Center"/>
                
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <app:JobApplicationsListPanel 
                        Applications="{Binding AllApplications}" />
                </ScrollViewer>

                <Button 
                    Grid.Row="3"
                    Content="Logout"
                    Command="{Binding LogoutCommand}"
                    Width="120" 
                    Height="35"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>