<UserControl x:Class="Control.Components.JobApplication.JobApplicationForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:listPanel="clr-namespace:Control.Components.OptionList"
             mc:Ignorable="d">

    <Border Padding="20">
        <StackPanel Width="500">

            <TextBlock Text="Position*" FontWeight="SemiBold"/>
            <TextBox
                Text="{Binding Position, UpdateSourceTrigger=PropertyChanged}"
                Padding="5"
                Margin="0,5,0,15"/>

            <TextBlock FontWeight="SemiBold">
                <Run Text="Cover Letter*"/>
                <Run Text=" (min. 200 characters)" FontSize="10" Foreground="Gray" FontWeight="Normal"/>
            </TextBlock>
            <TextBox
                Text="{Binding CoverLetter, UpdateSourceTrigger=PropertyChanged}"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                VerticalContentAlignment="Top"
                Padding="5"
                Height="120"
                Margin="0,5,0,20"/>

            <listPanel:OptionListPanel 
               OptionLists="{Binding OptionLists}" 
               Margin="0,0,0,20"/>

            <Button
                Content="Send Application"
                Command="{Binding SubmitCommand}"
                FontWeight="Bold"
                Cursor="Hand"
                Height="40"/>
        </StackPanel>
    </Border>
</UserControl>