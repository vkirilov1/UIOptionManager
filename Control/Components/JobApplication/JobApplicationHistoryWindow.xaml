<Window x:Class="Control.Components.JobApplication.JobApplicationHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Application History" Height="400" Width="500" 
        WindowStartupLocation="CenterOwner" Background="#F0F8FF">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Your Applications" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

            <DataGrid ItemsSource="{Binding History}" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True" 
                      Background="White"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Position" Binding="{Binding Position}" Width="*" />
                    <DataGridTextColumn Header="Type" Binding="{Binding EmploymentType}" Width="100" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Button Content="Close" Click="CloseClick" Margin="0,20,0,0" Width="100" HorizontalAlignment="Right"/>
        </StackPanel>
    </Grid>
</Window>